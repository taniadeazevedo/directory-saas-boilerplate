# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Database (Postgres). Works with Supabase, Neon, Railway, or a local Postgres.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/directory_db"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# Generate AUTH_SECRET with: npx auth secret
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-random-32-byte-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Lemon Squeezy (Payments)
# https://app.lemonsqueezy.com/settings/api
# ---------------------------------------------------------------------------
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
# Variant IDs from your Lemon Squeezy store products (Featured / Sponsor plans)
LEMONSQUEEZY_VARIANT_FEATURED=""
LEMONSQUEEZY_VARIANT_SPONSOR=""

# ---------------------------------------------------------------------------
# Resend (Emails)
# https://resend.com/api-keys
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# ---------------------------------------------------------------------------
# UploadThing (image / logo uploads)
# https://uploadthing.com/dashboard
# ---------------------------------------------------------------------------
UPLOADTHING_TOKEN=""

# ---------------------------------------------------------------------------
# Cron (Vercel Cron -> app/api/cron/expire-listings)
# ---------------------------------------------------------------------------
CRON_SECRET="replace-with-a-random-secret"

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# ---------------------------------------------------------------------------
# Demo mode — set to "true" ONLY on a public marketplace/demo deployment.
# Shows a dismissible banner with the seeded admin/demo credentials so
# reviewers can try the app without registering. Leave unset for a real
# buyer's production deployment.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEMO_MODE=""
